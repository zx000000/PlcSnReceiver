<Window x:Class="PlcSnReceiver.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:uc="clr-namespace:PlcSnReceiver.UserControls"
        Title="PLC FINS UDP SN 接收工具" Height="720" Width="1120"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <TabControl x:Name="MainTabs">
            <TabItem Header="状态监控">
                <uc:MonitorPage x:Name="UcMonitor"/>
            </TabItem>
            <TabItem Header="历史查询">
                <uc:QueryPage x:Name="UcQuery"/>
            </TabItem>
            <TabItem Header="参数配置">
                <uc:ConfigPage x:Name="UcConfig"/>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
