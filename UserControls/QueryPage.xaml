<UserControl x:Class="PlcSnReceiver.UserControls.QueryPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="1000">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 查询条件 -->
        <GroupBox Header="查询条件" Grid.Row="0" Margin="0 0 0 8">
            <Grid Margin="5">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Grid.Row="0">
                    <TextBlock Text="通道：" VerticalAlignment="Center"/>
                    <ComboBox x:Name="CboChannel" Width="120" VerticalAlignment="Center" Margin="0 0 20 0"/>
                    <TextBlock Text="起始时间：" VerticalAlignment="Center"/>
                    <DatePicker x:Name="DpStart" Width="130" VerticalAlignment="Center" Margin="0 0 20 0"/>
                    <TextBlock Text="结束时间：" VerticalAlignment="Center"/>
                    <DatePicker x:Name="DpEnd" Width="130" VerticalAlignment="Center" Margin="0 0 20 0"/>
                    <TextBlock Text="字段：" VerticalAlignment="Center"/>
                    <ComboBox x:Name="CboField" Width="130" VerticalAlignment="Center" Margin="0 0 20 0"/>
                    <TextBlock Text="关键词：" VerticalAlignment="Center"/>
                    <TextBox x:Name="TxtKeyword" Width="160" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Grid.Row="1" Margin="0 10 0 0">
                    <TextBlock Text="（支持任意起止日期，默认查询最近24小时）" VerticalAlignment="Center"
                               Foreground="Gray" Margin="0 0 20 0"/>
                    <Button x:Name="BtnQuery" Content="查询" Width="90"/>
                    <Button x:Name="BtnReset" Content="重置" Width="90" Margin="10 0 0 0"/>
                </StackPanel>
            </Grid>
        </GroupBox>

        <!-- 查询结果 -->
        <GroupBox Header="查询结果" Grid.Row="1" Margin="0 0 0 8">
            <DataGrid x:Name="DgQueryResult" Margin="5" IsReadOnly="True" AutoGenerateColumns="False"
                      AlternatingRowBackground="#F5F6F8"/>
        </GroupBox>

        <StackPanel Orientation="Horizontal" Grid.Row="2">
            <TextBlock x:Name="TxtCount" Text="共 0 条" VerticalAlignment="Center" Margin="0 0 15 0"/>
            <Button x:Name="BtnExportQuery" Content="导出查询结果CSV" Width="160"/>
        </StackPanel>
    </Grid>
</UserControl>
